{
  "name": "step-into-story-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type:check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run type:check && npm test",
    "secrets:generate": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-secrets.ps1",
    "secrets:scan": "npx trufflehog filesystem .",
    "pre-commit": "npx trufflehog filesystem .",
    "test:ui": "vitest --ui",
    "build:clean": "rimraf .next",
    "format": "prettier --write .",
    "fix:types": "node scripts/type-migration.js",
    "analyze": "node scripts/analyze-bundle.js",
    "monitor": "node scripts/performance-monitor.js",
    "verify:env": "node scripts/verify-env.js",
    "deploy:prepare": "npm run build:clean && npm run build",
    "deploy:vercel": "vercel --prod",
    "deploy:fix": "node scripts/deploy-to-vercel.js",
    "fix:dependencies": "node scripts/fix-dependency-conflict.js",
    "fix:vercel": "node scripts/fix-vercel-deployment.js",
    "generate:env-script": "node scripts/generate-env-script.js",
    "security:check": "node scripts/security-check.js",
    "setup:vercel": "node scripts/setup-vercel-env.js",
    "setup:local": "node scripts/setup-local-env.js",
    "postinstall": "node scripts/handle-postinstall.js",
    "prepare": "node scripts/handle-prepare.js",
    "prepare:vercel": "node scripts/prepare-for-vercel.js",
    "test:circuit-breaker": "ts-node -P tsconfig.scripts.json src/scripts/test-circuit-breaker.ts",
    "setup:supabase": "node scripts/setup-supabase-env.js"
  },
  "dependencies": {
    "@agentdeskai/browser-tools-mcp": "^1.0.11",
    "@emotion/is-prop-valid": "^1.3.1",
    "@opentelemetry/api": "^1.9.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/auth-helpers-nextjs": "^0.9.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@types/uuid": "^10.0.0",
    "@upstash/redis": "^1.34.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^0.2.4",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "critters": "^0.0.23",
    "dotenv": "^16.0.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.477.0",
    "next": "14.1.0",
    "next-themes": "^0.4.6",
    "opossum": "^8.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "reading-time": "^1.5.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.6.0",
    "use-sound": "^5.0.0",
    "uuid": "^11.0.5",
    "web-vitals": "^4.2.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.0.0",
    "@google/generative-ai": "^0.24.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.8",
    "@types/opossum": "^8.1.8",
    "@types/react": "18.2.48",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.7",
    "autoprefixer": "^10.4.21",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "cursor-tools": "latest",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.0.0",
    "husky": "^9.0.11",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.86.2",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1",
    "prettier": "^3.2.5",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "url-loader": "^4.1.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.2.4"
}
